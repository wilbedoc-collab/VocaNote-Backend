{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VocaNote Semantic Chunk Output",
  "type": "object",
  "required": [
    "schema_version",
    "chunk_id",
    "input_hash",
    "summary",
    "topics",
    "key_points",
    "decisions",
    "action_items",
    "questions",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic_chunk_output_v1"
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^chunk_[0-9]{4}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "key_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "text",
        "source_segment_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_segment_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
