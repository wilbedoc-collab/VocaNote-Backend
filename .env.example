# VocaNote backend local configuration example
# Copy to .env or export these variables in your service manager.

VOCANOTE_UPLOAD_TOKEN=change-me
VOCANOTE_RECORDINGS_DIR=/path/to/vocanote/recordings
# Production default: whisper.cpp + Metal + large-v3 + -mc 0.
# Rollback: set VOCANOTE_STT_ENGINE=openai_whisper and restart the worker.
VOCANOTE_STT_ENGINE=whisper_cpp
VOCANOTE_WHISPER_MODEL=large-v3
VOCANOTE_WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
VOCANOTE_WHISPER_CPP_MODEL=/path/to/ggml-large-v3.bin
VOCANOTE_STT_TIMEOUT_SECONDS=14400
VOCANOTE_HERMES_PROFILE=vocanoteworker
VOCANOTE_SEMANTIC_EXECUTOR=hermes
VOCANOTE_FAULT_INJECTION_ENABLED=0
VOCANOTE_CLOUD_ARCHIVE_ENABLED=0
