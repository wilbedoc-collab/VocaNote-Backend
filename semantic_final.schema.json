{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VocaNote Semantic Final",
  "type": "object",
  "required": [
    "schema_version",
    "recording_id",
    "reduce_input_hash",
    "summary",
    "topics",
    "key_points",
    "decisions",
    "action_items",
    "questions",
    "source_chunk_count",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic_final_v1"
    },
    "recording_id": {
      "type": "string",
      "minLength": 1
    },
    "reduce_input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_segment_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_segment_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_segment_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_segment_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_segment_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "source_chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
